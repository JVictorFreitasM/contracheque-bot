# Banco de dados
# String de conexão do PostgreSQL usada pelo Prisma
DATABASE_URL=

# ERP WK Radar
# URL base da API do ERP WK (usada para autenticação e busca de funcionários/folha)
WK_BASE_URL=
WK_EMPRESA=
WK_USUARIO=
WK_SENHA=

# Redis
# Usado pelas filas do BullMQ. REDIS_HOST/REDIS_PORT são usados para montar a conexão
# por padrão; se preferir, defina REDIS_URL diretamente (ela tem prioridade sobre host/port)
REDIS_HOST=
REDIS_PORT=
# REDIS_URL=redis://localhost:6379

# Evolution API (WhatsApp)
# Valores usados apenas como fallback inicial ao criar a configuração no banco
# (tabela Configuracao); depois de criada, a configuração real é editada pela
# tela de Configurações do frontend, não por estas variáveis
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_INSTANCE=bot-contracheque
# Chave sensível — não commitar valor real, preencher apenas localmente/no servidor
EVOLUTION_API_KEY=sua_chave_aqui
# Token usado para validar requisições recebidas em POST /api/webhooks/evolution
# (deve ser incluído como ?token=... na URL configurada na instância da Evolution API).
# Sensível — não commitar valor real. Se deixado vazio, o webhook não valida token (não recomendado em produção)
EVOLUTION_WEBHOOK_TOKEN=

# Agendamento
MODO_SIMULACAO=
# Dia do mês em que o envio automático de contracheques é disparado (padrão: 5)
DIA_ENVIO_CONTRACHEQUES=

# Servidor
# 3001 (não 3000) — porta do IdP colidia com o default do Bot; ver OS 08-A/08-B, resolução
# do conflito de porta: IdP fica em 3000, Bot em 3001
PORT=3001
# Ambiente de execução (ex.: production habilita logs em formato JSON, sem "pretty print")
# NODE_ENV=production

# IdP centralizado (OS 08-B)
# URL base do IdP, usada server-to-server (troca de code por token, JWKS) - de onde
# o backend rodar. Rodando via `npm start` direto no host (sem Docker), é localhost mesmo
IDP_URL=http://localhost:3000
# Opcional — só necessário se o backend rodar containerizado (Docker) enquanto o IdP
# roda no host: nesse caso IDP_URL vira http://host.docker.internal:3000 (visível só
# de dentro do container) e IDP_AUTHORIZE_URL precisa ser http://localhost:3000 (o
# valor que o NAVEGADOR do usuário consegue resolver, usado só no redirect de
# /auth/login). Sem Docker, não precisa definir - cai no próprio IDP_URL.
# IDP_AUTHORIZE_URL=http://localhost:3000
# OS 17: menu central do IdP (OS 13), usado no link "Voltar aos sistemas" das telas
# de erro de login. Sem definir, cai em `${IDP_URL}/home`.
# IDP_HOME_URL=http://localhost:3000/home
# Credenciais do sistema cadastradas no painel do IdP (OS 08-A). Sensível — não commitar valor real
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
# Deve bater exatamente com um dos redirectUris cadastrados no sistema no IdP
IDP_REDIRECT_URI=http://localhost:3001/auth/callback
# Segredo usado pelo express-session para assinar o cookie de sessão local (não é enviado ao IdP).
# Sensível — não commitar valor real, gerar uma string aleatória por ambiente
SESSION_SECRET=
# Cookie de sessão só é enviado em conexão HTTPS quando true (OS 15-A). Manter "false"
# apenas em ambiente localhost sem HTTPS; mudar para "true" assim que o sistema tiver
# certificado (OS 14, ainda não iniciada) — cookie.secure=true bloqueia o cookie em HTTP puro.
COOKIE_SECURE=false
# Origem do frontend (Vite dev server) — usada para redirecionar de volta ao painel após
# login/logout no IdP, já que o callback roda no backend (porta acima), não no Vite
FRONTEND_URL=http://localhost:5173
