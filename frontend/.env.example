# OS 15-A: origem absoluta do backend, usada pelo proxy do Vite e para montar as
# URLs de /auth/login e /auth/logout (que rodam no backend, fora do proxy).
VITE_BACKEND_URL=http://localhost:3001
# Origem do próprio frontend, usada para montar o returnTo de volta ao painel
# depois do login/logout no IdP.
VITE_FRONTEND_URL=http://localhost:5173
# OS 17: menu central do IdP (OS 13), pro botão "Voltar aos sistemas" na sidebar.
VITE_IDP_HOME_URL=http://localhost:3000/home
